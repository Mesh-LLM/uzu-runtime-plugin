+
+#[rocket::async_test]
+async fn nonstreaming_response_has_fixed_length_json() {
+    #[rocket::get("/")]
+    fn response() -> ChatCompletionResult {
+        ChatCompletionResult::Json(Status::Ok, br#"{"choices":[]}"#.to_vec())
+    }
+    let client = rocket::local::asynchronous::Client::tracked(rocket::build().mount("/", rocket::routes![response]))
+        .await
+        .unwrap();
+    let response = client.get("/").dispatch().await;
+    assert_eq!(response.status(), Status::Ok);
+    assert_eq!(response.content_type(), Some(ContentType::JSON));
+    assert_eq!(response.headers().get_one("Content-Length"), Some("14"));
+    assert!(response.headers().get_one("Transfer-Encoding").is_none());
+    let body = response.into_string().await.unwrap();
+    assert_eq!(serde_json::from_str::<serde_json::Value>(&body).unwrap(), serde_json::json!({"choices": []}));
+}

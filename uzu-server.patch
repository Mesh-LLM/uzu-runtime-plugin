--- a/crates/legacy/cli/unit/server/chat_completions_test.rs
+++ b/crates/legacy/cli/unit/server/chat_completions_test.rs
@@ -616,3 +616,21 @@ fn backend_error_bodies_are_openai_errors_with_collapsed_prefixes() {
     assert_eq!(body["error"]["type"], "server_error");
     assert_eq!(body["error"]["message"], "No response generated");
